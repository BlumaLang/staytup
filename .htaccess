DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. If the requested file or directory exists on disk, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 2. Route API calls directly to api/index.php
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # 3. Handle /staytup/ prefix links when deployed at domain root
    #    Redirects staytup.odireca.com/staytup/blend/invite/xyz -> staytup.odireca.com/blend/invite/xyz
    RewriteCond %{REQUEST_URI} ^/staytup/(.*)$
    RewriteCond %{DOCUMENT_ROOT}/staytup !-d
    RewriteRule ^staytup/(.*)$ /$1 [R=301,L]

    # 4. If index.php exists in this directory (PHP front-controller deployment)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|json|woff|woff2|ttf|eot|mp3|mp4|m4a)$ [NC]
    RewriteCond index.php -f
    RewriteRule ^ index.php [L,QSA]

    # 5. Fallback all other SPA deep links to index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.(js|css|png|jpg|jpeg|gif|svg|ico|webp|webmanifest|json|woff|woff2|ttf|eot|mp3|mp4|m4a)$ [NC]
    RewriteRule ^ index.html [L,QSA]
</IfModule>

# Safety fallback if mod_rewrite is disabled or bypassed
<IfModule !mod_rewrite.c>
    FallbackResource index.html
</IfModule>

# Caching & MIME types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
    # 1. Never cache Service Worker, version.json, or Web Manifest
    <FilesMatch "^(sw\.js|version\.json|manifest\.webmanifest|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>

    # 2. Never cache HTML or PHP SPA front controller responses
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 3. Allow immutable caching for fonts and static assets
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
