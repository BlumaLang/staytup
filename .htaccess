DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the requested file or directory exists on disk, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route API calls directly to api/index.php
    RewriteRule ^api(/.*)?$ api/index.php [L,QSA]

    # Pass all other SPA deep links and routes to front controller index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Caching & MIME types
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
    AddType application/javascript .js
    AddType text/css .css
</IfModule>

<IfModule mod_headers.c>
    # 1. Never cache Service Worker, version.json, or Web Manifest
    <FilesMatch "^(sw\.js|version\.json|manifest\.webmanifest|manifest\.json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
        Header set Service-Worker-Allowed "/"
    </FilesMatch>

    # 2. Never cache HTML or PHP SPA front controller responses
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # 3. Allow immutable caching for fonts and static assets
    <FilesMatch "\.(woff|woff2|ttf|eot)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
